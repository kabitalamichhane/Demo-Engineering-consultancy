# Copy this file to .env and fill in real values before running the project.
# NEVER commit .env to Git.

# --- Core ---------------------------------------------------------------
# Generate a key:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-key
# Local development: True.  PRODUCTION: False  (the app refuses to start in production
# with the default secret key or without explicit allowed hosts)
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# --- Admin hardening ----------------------------------------------------
# Move the admin away from /admin/ (no leading/trailing slash needed)
ADMIN_URL=hes-control-panel
# Require authenticator-app code for admin login (default: on when DEBUG=False).
# Run `python manage.py setup_admin_2fa <username>` for every admin FIRST.
ADMIN_REQUIRE_2FA=False
# Swagger/ReDoc pages (default: on only when DEBUG=True)
ENABLE_API_DOCS=True

# --- Brute-force protection (django-axes) -------------------------------
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=60

# --- Rate limits --------------------------------------------------------
FORM_SUBMIT_RATE=5/hour

# --- Reverse proxy (Nginx / Cloudflare) ---------------------------------
# How many proxies sit in front of Django. 0 = none (X-Forwarded-For ignored).
# Typical: 1 for Nginx only, 2 for Cloudflare + Nginx.
TRUSTED_PROXY_COUNT=0
# Set True only if Nginx/Cloudflare terminates HTTPS and forwards X-Forwarded-Proto
DJANGO_BEHIND_PROXY_SSL=False

# --- Database -----------------------------------------------------------
# Default is SQLite. For PostgreSQL in production:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=highnoon
# DB_USER=highnoon_user
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# --- CORS ---------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=False

# --- Cache (use Redis in production if you run multiple workers) --------
# DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# DJANGO_CACHE_LOCATION=redis://127.0.0.1:6379/1

# --- Email --------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info.highnoon2019@gmail.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=info.highnoon2019@gmail.com
COMPANY_NOTIFY_EMAIL=info.highnoon2019@gmail.com

# --- HTTPS (production only) -------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
# Turn on once HTTPS works everywhere, e.g. 31536000 (1 year)
DJANGO_HSTS_SECONDS=0
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

DEFAULT_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61587978670735

# --- Email alerts ---------------------------------------------------------
# For REAL emails use: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and a Gmail "App password" (Google Account -> Security -> 2-Step Verification -> App passwords)
SEND_AUTO_REPLY=True

# --- Error alerts & uptime ---------------------------------------------
# Server errors (500) are emailed to ERROR_EMAIL_TO when DJANGO_DEBUG=False and real SMTP email is set up.
SEND_ERROR_EMAILS=True
ERROR_EMAIL_TO=info.highnoon2019@gmail.com
# Point your uptime monitor at https://yourdomain.com/health/  (returns {"status": "ok"})

# Language switcher (English/Nepali/Hindi). Translations are built into the site - no outside service.
# Set False to hide the switcher.
ENABLE_LANGUAGE_SWITCHER=True
